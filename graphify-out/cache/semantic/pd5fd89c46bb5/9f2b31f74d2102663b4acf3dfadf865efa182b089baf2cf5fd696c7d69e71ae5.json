{"nodes": [{"id": "readme_arachne", "label": "Arachne", "file_type": "document", "source_file": "README.md", "source_location": "L1-L8", "source_url": null, "captured_at": null, "author": "Amsy", "contributor": "Claude (Anthropic)", "rationale": "Blender add-on packaging procedural web generation, GPU physics, and silk rendering into one sidebar panel; requires Blender 5.2 LTS minimum. MIT licensed."}, {"id": "readme_orb_web", "label": "Orb Web Generator", "file_type": "concept", "source_file": "README.md", "source_location": "L13-L15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Classic radial/spiral web; scalloped sag, uneven spiral spacing, damage gaps, asymmetry, wavy radials and tangle threads are deliberately added because perfectly regular geometry reads as synthetic \u2014 the irregularity sells a naturally aged web."}, {"id": "readme_chaotic_cobweb", "label": "Chaotic Cobweb Generator", "file_type": "concept", "source_file": "README.md", "source_location": "L16-L24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Simulated spiders spin threads between scene surfaces rather than fitting a parametric shape, so the web conforms to arbitrary corner/prop/room geometry. Construction adapted from Pixar's Toy Story 4 cobweb talk."}, {"id": "readme_clumping", "label": "Clumping", "file_type": "rationale", "source_file": "README.md", "source_location": "L19-L21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Draws spiders toward a few random attractor spots so dense knots alternate with sparser spans, reproducing the uneven density of real webs instead of uniform coverage."}, {"id": "readme_bridge_bias", "label": "Bridge Bias", "file_type": "rationale", "source_file": "README.md", "source_location": "L22-L24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single 0-1 knob for how much anchors commit to spanning gaps: 0 = local webbing hugging each surface, 1 = long cables between separate/floating geometry. Collapses a topology choice into one artist-facing slider."}, {"id": "readme_spread", "label": "Spread", "file_type": "rationale", "source_file": "README.md", "source_location": "L83-L85", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Controls how uniformly spiders fill the volume: 0 = dense local clumps, 1 = Pixar-style even coverage. Recommended dense reference look is 1200 Spin Steps with Spread 0.9."}, {"id": "readme_live_update", "label": "Live Update", "file_type": "concept", "source_file": "README.md", "source_location": "L26-L28", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rebuilds the web instantly on any parameter change so the look can be dialed in realtime before the (expensive) solver and strand stages are added."}, {"id": "readme_gpu_physics_solver", "label": "GPU Physics Solver", "file_type": "concept", "source_file": "README.md", "source_location": "L30-L46", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Built on Blender's native GPU module specifically so the add-on ships with zero external dependencies."}, {"id": "readme_verlet_pbd_solver", "label": "Verlet / PBD Solver with Tearing", "file_type": "concept", "source_file": "README.md", "source_location": "L32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Position-based dynamics with a tear threshold: threads snap when overstretched."}, {"id": "readme_unilateral_constraints", "label": "Silk-like Unilateral Constraints", "file_type": "rationale", "source_file": "README.md", "source_location": "L33", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Constraints only resist stretching, never compression \u2014 real silk pulls but cannot push, so a bilateral distance constraint would make slack threads springy and wrong."}, {"id": "readme_tension_control", "label": "Tension Control", "file_type": "rationale", "source_file": "README.md", "source_location": "L34, L81-L82", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Selects between taut webs and drooping catenaries; ~0.95 for taut structural webs, ~0.5 for droopy abandoned ones. Pair low tension with Deteriorate for an aged look."}, {"id": "readme_gravity_wind", "label": "World-space Gravity and Wind with Turbulence", "file_type": "concept", "source_file": "README.md", "source_location": "L35", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_collision", "label": "Collision (Bounding Sphere / SDF)", "file_type": "concept", "source_file": "README.md", "source_location": "L36-L38, L86-L88, L99-L100", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two tiers: bounding sphere for speed, baked SDF for accuracy. A collision collection merges all member meshes into one field so many colliders cost one lookup. SDF needs a closed mesh with outward normals; animated collider location is supported but rotation is frozen at bake, and deforming meshes fall back to the bounded shape."}, {"id": "readme_sdf_resolution", "label": "SDF Resolution", "file_type": "rationale", "source_file": "README.md", "source_location": "L88", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raise it for thin or detailed colliders \u2014 the baked field otherwise misses geometry smaller than a voxel."}, {"id": "readme_stickiness", "label": "Stickiness", "file_type": "rationale", "source_file": "README.md", "source_location": "L39-L41", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A tunable fraction of contacting points latch to the collider surface so the web drapes and clings instead of sliding off \u2014 pure collision response alone would let the web slip away."}, {"id": "readme_deteriorate", "label": "Deteriorate and Pre-warm", "file_type": "rationale", "source_file": "README.md", "source_location": "L42", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deteriorate pre-breaks threads for an aged look; pre-warm starts the sim already settled so frame 1 is usable without waiting for the web to relax."}, {"id": "readme_substeps", "label": "Substeps", "file_type": "rationale", "source_file": "README.md", "source_location": "L91", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raise when a fast collider tunnels through the web without tearing \u2014 the discrete timestep steps past the threads between iterations."}, {"id": "readme_render_frame_cache", "label": "Render-safe Frame Cache", "file_type": "rationale", "source_file": "README.md", "source_location": "L44-L46", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GPU compute cannot run on Blender's render thread, so every frame simulated in the viewport is cached and replayed during F12/animation renders. The user must play through the range once to 'bake'."}, {"id": "readme_pin_unpin", "label": "Anchor Pinning (Pin / Unpin)", "file_type": "concept", "source_file": "README.md", "source_location": "L76-L77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Anchor points are pinned automatically; overridden by selecting vertices in Edit Mode and using Pin / Unpin."}, {"id": "readme_strandify", "label": "Strandify", "file_type": "concept", "source_file": "README.md", "source_location": "L49-L50", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Converts the simulated web into smooth silk tubes using Catmull-Rom smoothing with a noisy radius, so the coarse simulation mesh does not need to be dense to render as fine silk."}, {"id": "readme_dew_droplets", "label": "Dew Droplets with Physics", "file_type": "concept", "source_file": "README.md", "source_location": "L51-L58", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Droplets cling to strands, condense and grow, slide down to hang under the silk, then drip off and free-fall once heavy enough, respawning at their birth spot for a perpetual drip cycle. Droplets on torn strands are flung off."}, {"id": "readme_bake_dew_for_render", "label": "Bake Dew for Render", "file_type": "rationale", "source_file": "README.md", "source_location": "L54-L58", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The render depsgraph cannot reuse the viewport's live simulation, so the bake stores droplet motion to disk and simultaneously fills the web solver's render cache."}, {"id": "readme_tension_heatmap", "label": "Tension Heatmap Material", "file_type": "concept", "source_file": "README.md", "source_location": "L59-L60, L89-L90", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Visualizes stretch from blue (rest) to red (about to tear); enabled via Show Tension on the Strandify modifier so the Tear Threshold can be tuned by eye."}, {"id": "readme_create_web_sim_strands", "label": "Create Web + Sim + Strands", "file_type": "concept", "source_file": "README.md", "source_location": "L71-L74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One-button quick-start operator that chains generation, solver setup and strand conversion; optional collider/anchor mesh is selected first."}, {"id": "readme_no_self_collision", "label": "No Thread Self-Collision", "file_type": "rationale", "source_file": "README.md", "source_location": "L98", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Self-collision between threads is deliberately not simulated \u2014 the broad-phase cost on a dense web would not pay for itself visually."}, {"id": "readme_farm_render_limitation", "label": "Command-line / Farm Render Limitation", "file_type": "rationale", "source_file": "README.md", "source_location": "L95-L97", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The GPU solver only runs during viewport playback and UI renders, so headless/farm rendering requires playing the shot through once and exporting the animated web (e.g. Alembic) first."}, {"id": "readme_chang_luoh_2019", "label": "Chang & Luoh, Dust and Cobwebs for Toy Story 4 (SIGGRAPH Talks 2019)", "file_type": "paper", "source_file": "README.md", "source_location": "L104-L105", "source_url": null, "captured_at": null, "author": "Chang & Luoh", "contributor": null}, {"id": "readme_thomas_kole_geonodes_cobwebs", "label": "Thomas Kole's Geometry Nodes Cobwebs", "file_type": "document", "source_file": "README.md", "source_location": "L105-L106", "source_url": null, "captured_at": null, "author": "Thomas Kole", "contributor": null}, {"id": "readme_blender_gpu_module", "label": "Blender Native GPU Module", "file_type": "concept", "source_file": "README.md", "source_location": "L30-L31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen as the compute backend precisely because it ships with Blender \u2014 no CUDA/taichi/numpy install step for the user."}], "edges": [{"source": "readme_arachne", "target": "readme_orb_web", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L12-L15", "weight": 1.0}, {"source": "readme_arachne", "target": "readme_chaotic_cobweb", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L16-L24", "weight": 1.0}, {"source": "readme_arachne", "target": "readme_gpu_physics_solver", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L30-L31", "weight": 1.0}, {"source": "readme_arachne", "target": "readme_strandify", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L48-L50", "weight": 1.0}, {"source": "readme_chaotic_cobweb", "target": "readme_chang_luoh_2019", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L17-L18", "weight": 1.0}, {"source": "readme_arachne", "target": "readme_thomas_kole_geonodes_cobwebs", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L105-L106", "weight": 1.0}, {"source": "readme_clumping", "target": "readme_chaotic_cobweb", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L19-L21", "weight": 1.0}, {"source": "readme_bridge_bias", "target": "readme_chaotic_cobweb", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L22-L24", "weight": 1.0}, {"source": "readme_spread", "target": "readme_chaotic_cobweb", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L83-L85", "weight": 1.0}, {"source": "readme_spread", "target": "readme_clumping", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "README.md", "source_location": "L19-L21, L83-L85", "weight": 1.0}, {"source": "readme_spread", "target": "readme_clumping", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "README.md", "source_location": "L19-L21, L83-L85", "weight": 1.0}, {"source": "readme_spread", "target": "readme_chang_luoh_2019", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L84-L85", "weight": 1.0}, {"source": "readme_live_update", "target": "readme_orb_web", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L26-L28", "weight": 1.0}, {"source": "readme_live_update", "target": "readme_chaotic_cobweb", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L26-L28", "weight": 1.0}, {"source": "readme_gpu_physics_solver", "target": "readme_blender_gpu_module", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L30-L31", "weight": 1.0}, {"source": "readme_gpu_physics_solver", "target": "readme_verlet_pbd_solver", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L32", "weight": 1.0}, {"source": "readme_verlet_pbd_solver", "target": "readme_unilateral_constraints", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L32-L33", "weight": 1.0}, {"source": "readme_tension_control", "target": "readme_verlet_pbd_solver", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L34", "weight": 1.0}, {"source": "readme_gpu_physics_solver", "target": "readme_gravity_wind", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L35", "weight": 1.0}, {"source": "readme_gpu_physics_solver", "target": "readme_collision", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L36-L38", "weight": 1.0}, {"source": "readme_sdf_resolution", "target": "readme_collision", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L86-L88", "weight": 1.0}, {"source": "readme_stickiness", "target": "readme_collision", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L39-L41", "weight": 1.0}, {"source": "readme_substeps", "target": "readme_collision", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L91", "weight": 1.0}, {"source": "readme_substeps", "target": "readme_verlet_pbd_solver", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "README.md", "source_location": "L91", "weight": 1.0}, {"source": "readme_deteriorate", "target": "readme_verlet_pbd_solver", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L42", "weight": 1.0}, {"source": "readme_deteriorate", "target": "readme_tension_control", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L81-L82", "weight": 1.0}, {"source": "readme_deteriorate", "target": "readme_orb_web", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "README.md", "source_location": "L13-L15, L42", "weight": 1.0}, {"source": "readme_deteriorate", "target": "readme_orb_web", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "README.md", "source_location": "L13-L15, L42", "weight": 1.0}, {"source": "readme_gpu_physics_solver", "target": "readme_render_frame_cache", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L44-L46", "weight": 1.0}, {"source": "readme_render_frame_cache", "target": "readme_blender_gpu_module", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L44-L46", "weight": 1.0}, {"source": "readme_farm_render_limitation", "target": "readme_render_frame_cache", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "README.md", "source_location": "L44-L46, L95-L97", "weight": 1.0}, {"source": "readme_farm_render_limitation", "target": "readme_gpu_physics_solver", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L95-L97", "weight": 1.0}, {"source": "readme_no_self_collision", "target": "readme_gpu_physics_solver", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L98", "weight": 1.0}, {"source": "readme_pin_unpin", "target": "readme_gpu_physics_solver", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "README.md", "source_location": "L76-L77", "weight": 1.0}, {"source": "readme_pin_unpin", "target": "readme_chaotic_cobweb", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "README.md", "source_location": "L71-L77", "weight": 1.0}, {"source": "readme_strandify", "target": "readme_gpu_physics_solver", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L49-L50", "weight": 1.0}, {"source": "readme_strandify", "target": "readme_tension_heatmap", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L89-L90", "weight": 1.0}, {"source": "readme_tension_heatmap", "target": "readme_verlet_pbd_solver", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "README.md", "source_location": "L59-L60, L89-L90", "weight": 1.0}, {"source": "readme_dew_droplets", "target": "readme_strandify", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L51-L54", "weight": 1.0}, {"source": "readme_dew_droplets", "target": "readme_verlet_pbd_solver", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "README.md", "source_location": "L54", "weight": 1.0}, {"source": "readme_bake_dew_for_render", "target": "readme_dew_droplets", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L54-L58", "weight": 1.0}, {"source": "readme_bake_dew_for_render", "target": "readme_render_frame_cache", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L57-L58", "weight": 1.0}, {"source": "readme_bake_dew_for_render", "target": "readme_render_frame_cache", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.9, "source_file": "README.md", "source_location": "L44-L46, L54-L58", "weight": 1.0}, {"source": "readme_create_web_sim_strands", "target": "readme_chaotic_cobweb", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L71-L73", "weight": 1.0}, {"source": "readme_create_web_sim_strands", "target": "readme_gpu_physics_solver", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "README.md", "source_location": "L73", "weight": 1.0}, {"source": "readme_create_web_sim_strands", "target": "readme_strandify", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "README.md", "source_location": "L73", "weight": 1.0}, {"source": "readme_create_web_sim_strands", "target": "readme_collision", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L71-L74", "weight": 1.0}, {"source": "readme_orb_web", "target": "readme_chaotic_cobweb", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.8, "source_file": "README.md", "source_location": "L12-L24", "weight": 1.0}, {"source": "readme_stickiness", "target": "readme_pin_unpin", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "README.md", "source_location": "L39-L41, L76-L77", "weight": 1.0}, {"source": "readme_bridge_bias", "target": "readme_collision", "relation": "conceptually_related_to", "confidence": "AMBIGUOUS", "confidence_score": 0.25, "source_file": "README.md", "source_location": "L22-L24, L71-L72", "weight": 1.0}], "hyperedges": [{"id": "render_bake_pipeline", "label": "Render-time Bake Pipeline (GPU sim cannot run on the render thread)", "nodes": ["readme_gpu_physics_solver", "readme_render_frame_cache", "readme_bake_dew_for_render", "readme_dew_droplets", "readme_farm_render_limitation"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "README.md"}, {"id": "aged_web_look_controls", "label": "Aged / Natural Web Look Controls", "nodes": ["readme_deteriorate", "readme_tension_control", "readme_orb_web", "readme_clumping", "readme_spread"], "relation": "form", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "README.md"}, {"id": "web_creation_flow", "label": "Generate to Simulate to Render Flow", "nodes": ["readme_create_web_sim_strands", "readme_chaotic_cobweb", "readme_orb_web", "readme_gpu_physics_solver", "readme_strandify", "readme_pin_unpin"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md"}]}